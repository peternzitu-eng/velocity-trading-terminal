# Copy this to .env for local dev, or paste into Vercel Environment Variables dashboard

# Required: Vercel KV (get from vercel.com > Storage > Create KV Database)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Optional: Gemini AI chat
GEMINI_API_KEY=your_gemini_api_key

# Optional: MetaAPI for live MT5 trading
META_API_TOKEN=your_meta_api_token

# Webhook security (change this!)
WEBHOOK_SECRET=changeme

# General config
EXCHANGE=Multi-Market Live Feed
